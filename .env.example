# ---- LLM providers (all have free tiers) ----
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ---- App ----
# Key clients must send in the X-API-Key header. Make up any long random string.
API_KEY=change-me
# Key the backend uses to talk to the LiteLLM gateway. Make up another random string.
LITELLM_MASTER_KEY=sk-change-me
# Docker Compose overrides these two; set them for local (non-Docker) runs.
REDIS_URL=redis://localhost:6379/0
LITELLM_URL=http://localhost:4000

# ---- LangSmith (optional; leave the key empty to skip tracing) ----
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartroute
# (LANGSMITH_TRACING is informational: tracing is on whenever LANGSMITH_API_KEY is set)
LANGSMITH_TRACING=true

# ---- Cache and rate limit ----
CACHE_ENABLED=true
CACHE_TTL=300
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW=60
